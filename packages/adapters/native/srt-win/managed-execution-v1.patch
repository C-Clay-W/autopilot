new file mode 100644
index 0000000..fee3cc9
--- /dev/null
+++ b/src/job_control.rs
@@ -0,0 +1,169 @@
+// 中文用途：用每次执行独立的私有继承管道和真实 Job 副本确认 Windows 目标容器清空。
+use anyhow::{anyhow, Context, Result};
+use serde::{Deserialize, Serialize};
+use std::{ffi::c_void, mem::{size_of, zeroed}, time::{Duration, Instant}};
+use windows::Win32::{
+    Foundation::{DuplicateHandle, SetHandleInformation, HANDLE, HANDLE_FLAGS, HANDLE_FLAG_INHERIT, DUPLICATE_SAME_ACCESS, DUPLICATE_HANDLE_OPTIONS, WAIT_OBJECT_0},
+    Storage::FileSystem::{ReadFile, WriteFile, GetFileType, FILE_TYPE_PIPE},
+    System::{JobObjects::{TerminateJobObject, QueryInformationJobObject, JobObjectBasicAccountingInformation, JOBOBJECT_BASIC_ACCOUNTING_INFORMATION, JOB_OBJECT_QUERY, JOB_OBJECT_TERMINATE},
+        Pipes::{CreatePipe, PeekNamedPipe}, Threading::{GetCurrentProcess, GetStartupInfoW, STARTUPINFOW, WaitForSingleObject, TerminateProcess}},
+};
+use crate::util::OwnedHandle;
+
+#[derive(Debug, Serialize, Deserialize)]
+pub struct RunnerControl {
+    pub report: usize,
+    pub acknowledge: usize,
+}
+
+pub struct BrokerControl {
+    host: OwnedHandle,
+    report: OwnedHandle,
+    acknowledge: OwnedHandle,
+    runner: OwnedHandle,
+}
+
+// 中文用途：所有句柄均为本实例独占的 Win32 内核能力，可转交一个控制线程。
+unsafe impl Send for BrokerControl {}
+
+// 中文用途：精确读取 Node/libuv STARTUPINFO 的 fd3，不接受 argv/env 提供的任意句柄。
+pub fn inherited_host_pipe() -> Result<HANDLE> {
+    let mut startup: STARTUPINFOW = unsafe { zeroed() };
+    unsafe { GetStartupInfoW(&mut startup) };
+    let bytes = startup.cbReserved2 as usize;
+    if startup.lpReserved2.is_null() || bytes < 4 { return Err(anyhow!("job control: missing inherited fd3")); }
+    let data = unsafe { std::slice::from_raw_parts(startup.lpReserved2, bytes) };
+    let count = u32::from_le_bytes(data[..4].try_into()?) as usize;
+    if count != 4 || bytes != 4 + count + count * size_of::<usize>() || data[7] & 0x09 != 0x09 {
+        return Err(anyhow!("job control: invalid libuv stdio layout"));
+    }
+    let offset = 4 + count + 3 * size_of::<usize>();
+    let value = usize::from_le_bytes(data[offset..offset + size_of::<usize>()].try_into()?);
+    let handle = HANDLE(value as *mut c_void);
+    if value == 0 || value == usize::MAX || unsafe { GetFileType(handle) } != FILE_TYPE_PIPE {
+        return Err(anyhow!("job control: fd3 is not a pipe"));
+    }
+    unsafe { SetHandleInformation(handle, HANDLE_FLAG_INHERIT.0, HANDLE_FLAGS(0)) }.context("job control: clear inherit")?;
+    Ok(handle)
+}
+
+// 中文用途：创建非继承匿名管道，再仅向挂起的真实 runner 复制其端点。
+fn runner_pipe(runner: HANDLE, runner_writes: bool) -> Result<(OwnedHandle, usize)> {
+    let mut read = HANDLE::default();
+    let mut write = HANDLE::default();
+    unsafe { CreatePipe(&mut read, &mut write, None, 0) }.context("control CreatePipe")?;
+    let (broker, source) = if runner_writes { (OwnedHandle(read), OwnedHandle(write)) } else { (OwnedHandle(write), OwnedHandle(read)) };
+    let mut target = HANDLE::default();
+    unsafe { DuplicateHandle(GetCurrentProcess(), source.raw(), runner, &mut target, 0, false, DUPLICATE_SAME_ACCESS) }.context("control DuplicateHandle into runner")?;
+    Ok((broker, target.0 as usize))
+}
+
+// 中文用途：绑定当前真实 runner 进程句柄及两条私有管道，绝不通过 PID 重开进程。
+pub fn bind_runner(runner: HANDLE, host: HANDLE) -> Result<(BrokerControl, RunnerControl)> {
+    let (report, report_value) = runner_pipe(runner, true)?;
+    let (acknowledge, acknowledge_value) = runner_pipe(runner, false)?;
+    let mut retained = HANDLE::default();
+    unsafe { DuplicateHandle(GetCurrentProcess(), runner, GetCurrentProcess(), &mut retained, 0, false, DUPLICATE_SAME_ACCESS) }.context("retain runner handle")?;
+    Ok((BrokerControl { host: OwnedHandle(host), report, acknowledge, runner: OwnedHandle(retained) }, RunnerControl { report: report_value, acknowledge: acknowledge_value }))
+}
+
+// 中文用途：完成固定长度写入，零字节或管道错误均失败。
+fn write_all(handle: HANDLE, mut data: &[u8]) -> Result<()> {
+    while !data.is_empty() {
+        let mut count = 0;
+        unsafe { WriteFile(handle, Some(data), Some(&mut count), None) }.context("control write")?;
+        if count == 0 { return Err(anyhow!("control zero write")); }
+        data = &data[count as usize..];
+    }
+    Ok(())
+}
+
+// 中文用途：以有界轮询精确读取固定帧，避免坏端点无限阻塞。
+fn read_exact(handle: HANDLE, data: &mut [u8]) -> Result<()> {
+    let deadline = Instant::now() + Duration::from_secs(10);
+    let mut offset = 0;
+    while offset < data.len() {
+        let mut available = 0;
+        unsafe { PeekNamedPipe(handle, None, 0, None, Some(&mut available), None) }.context("control peek")?;
+        if available == 0 {
+            if Instant::now() >= deadline { return Err(anyhow!("control read timeout")); }
+            std::thread::sleep(Duration::from_millis(10));
+            continue;
+        }
+        let mut count = 0;
+        unsafe { ReadFile(handle, Some(&mut data[offset..]), Some(&mut count), None) }.context("control read")?;
+        if count == 0 { return Err(anyhow!("control EOF")); }
+        offset += count as usize;
+    }
+    Ok(())
+}
+
+// 中文用途：runner 在目标创建前移交 Job，再等待 broker 确认持有真实副本。
+pub fn publish_job(control: &RunnerControl, job: HANDLE) -> Result<()> {
+    write_all(HANDLE(control.report as *mut c_void), &(job.0 as usize).to_le_bytes())?;
+    let mut ack = [0];
+    read_exact(HANDLE(control.acknowledge as *mut c_void), &mut ack)?;
+    if ack != [1] { return Err(anyhow!("control invalid job binding acknowledgement")); }
+    Ok(())
+}
+
+// 中文用途：只有目标已 assign/resume 后通知 broker 可以处理排队的停止。
+pub fn publish_ready(control: &RunnerControl) -> Result<()> {
+    write_all(HANDLE(control.report as *mut c_void), &[1])
+}
+
+// 中文用途：终止指定 Job 并检查真实 ActiveProcesses=0，终止成功本身不是空容器证明。
+fn terminate_empty(job: HANDLE) -> Result<()> {
+    unsafe { TerminateJobObject(job, 1) }.context("TerminateJobObject")?;
+    let deadline = Instant::now() + Duration::from_secs(5);
+    loop {
+        let mut info: JOBOBJECT_BASIC_ACCOUNTING_INFORMATION = unsafe { zeroed() };
+        unsafe { QueryInformationJobObject(Some(job), JobObjectBasicAccountingInformation, &mut info as *mut _ as *mut c_void, size_of::<JOBOBJECT_BASIC_ACCOUNTING_INFORMATION>() as u32, None) }.context("query active processes")?;
+        if info.ActiveProcesses == 0 { return Ok(()); }
+        if Instant::now() >= deadline { return Err(anyhow!("container empty timeout")); }
+        std::thread::sleep(Duration::from_millis(10));
+    }
+}
+
+impl BrokerControl {
+    // 中文用途：排队 stop 至 assign/resume 完成，正常 runner 退出或断连也清空目标 Job。
+    pub fn run(self) -> Result<()> {
+        let mut raw = [0; size_of::<usize>()];
+        read_exact(self.report.raw(), &mut raw)?;
+        let mut duplicate = HANDLE::default();
+        unsafe { DuplicateHandle(self.runner.raw(), HANDLE(usize::from_le_bytes(raw) as *mut c_void), GetCurrentProcess(), &mut duplicate, (JOB_OBJECT_QUERY | JOB_OBJECT_TERMINATE).0, false, DUPLICATE_HANDLE_OPTIONS(0)) }.context("duplicate target job")?;
+        let job = OwnedHandle(duplicate);
+        let result = (|| -> Result<()> {
+            write_all(self.acknowledge.raw(), &[1])?;
+            let mut ready = [0];
+            read_exact(self.report.raw(), &mut ready)?;
+            if ready != [1] { return Err(anyhow!("invalid ready frame")); }
+            write_all(self.host.raw(), b"SRTJOB1\n")?;
+            loop {
+                let mut available = 0;
+                unsafe { PeekNamedPipe(self.host.raw(), None, 0, None, Some(&mut available), None) }.context("host control disconnected")?;
+                if available > 0 {
+                    if available != 1 { return Err(anyhow!("invalid stop frame length")); }
+                    let mut stop = [0];
+                    read_exact(self.host.raw(), &mut stop)?;
+                    if stop != [1] { return Err(anyhow!("invalid stop frame")); }
+                    terminate_empty(job.raw())?;
+                    // runner 的恢复点已越过，后续代码只等待目标并退出，不再创建成员。
+                    write_all(self.host.raw(), b"EMPTY1\n")?;
+                    return Ok(());
+                }
+                if unsafe { WaitForSingleObject(self.runner.raw(), 0) } == WAIT_OBJECT_0 {
+                    return terminate_empty(job.raw());
+                }
+                std::thread::sleep(Duration::from_millis(10));
+            }
+        })();
+        if result.is_err() {
+            // 先等待 runner 退出，避免确认空后 runner 又把新目标分配到 Job。
+            unsafe { TerminateProcess(self.runner.raw(), 1) }.context("control failure terminate runner")?;
+            if unsafe { WaitForSingleObject(self.runner.raw(), 5000) } != WAIT_OBJECT_0 { return Err(anyhow!("control failure runner exit timeout")); }
+            terminate_empty(job.raw())?;
+        }
+        result
+    }
+}
