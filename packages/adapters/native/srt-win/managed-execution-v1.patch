+// 中文用途：将 broker 原始 stdin 按块转发到 runner，EOF 或下游关闭时结束，并保留非预期 I/O 错误。
+fn pump_stdin(src: HANDLE, dst: HANDLE) -> Result<()> {
+    let mut buf = [0u8; 8192];
+    loop {
+        let mut read = 0u32;
+        if let Err(e) = unsafe { ReadFile(src, Some(&mut buf), Some(&mut read), None) } {
+            if e.code() == ERROR_BROKEN_PIPE.to_hresult()
+                || e.code() == ERROR_OPERATION_ABORTED.to_hresult()
+            {
+                return Ok(());
+            }
+            return Err(e).context("read broker stdin");
+        }
+        if read == 0 {
+            return Ok(());
+        }
+        let mut offset = 0u32;
+        while offset < read {
+            let chunk = &buf[offset as usize..read as usize];
+            let mut wrote = 0u32;
+            if let Err(e) = unsafe { WriteFile(dst, Some(chunk), Some(&mut wrote), None) } {
+                if e.code() == ERROR_BROKEN_PIPE.to_hresult()
+                    || e.code() == ERROR_NO_DATA.to_hresult()
+                    || e.code() == ERROR_OPERATION_ABORTED.to_hresult()
+                {
+                    return Ok(());
+                }
+                return Err(e).context("forward broker stdin to runner");
+            }
+            if wrote == 0 {
+                return Err(anyhow!("forward broker stdin to runner: zero-byte write"));
+            }
+            offset += wrote;
+        }
+    }
+}
