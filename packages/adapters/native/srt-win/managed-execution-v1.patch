+        let trailing = br#"{"jsonrpc":"2.0","method":"tools/list"}"#;
+        let mut wire = Vec::new();
+        wire.extend_from_slice(&(body.len() as u32).to_le_bytes());
+        wire.extend_from_slice(body);
+        wire.extend_from_slice(trailing);
+        let mut wrote = 0u32;
+        unsafe { WriteFile(write.raw(), Some(&wire), Some(&mut wrote), None).unwrap() };
+        assert_eq!(wrote as usize, wire.len());
+
+        let mut length = [0u8; 4];
+        read_exact_from_stdin(read.raw(), &mut length, "test length").unwrap();
+        let mut received_body = vec![0u8; u32::from_le_bytes(length) as usize];
+        read_exact_from_stdin(read.raw(), &mut received_body, "test body").unwrap();
+        let mut received_trailing = vec![0u8; trailing.len()];
+        read_exact_from_stdin(read.raw(), &mut received_trailing, "test trailing bytes").unwrap();
+
+        assert_eq!(received_body, body);
+        assert_eq!(received_trailing, trailing);
+    }
 }
