{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "@autopilot-agent/desktop#build": {
      "dependsOn": ["^build"],
      "cache": false,
      "outputs": ["out/**"]
    },
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {}
  }
}
